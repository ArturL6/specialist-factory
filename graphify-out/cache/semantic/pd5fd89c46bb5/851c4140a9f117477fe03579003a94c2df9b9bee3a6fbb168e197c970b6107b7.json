{"nodes": [{"id": "readme_specialist_factory", "label": "Specialist Factory (POC)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teachers, aggregation, human labels, and student inference are intentionally kept separate so partially labeled text/image/image-text samples can be turned into specialist classifiers without coupling stages."}, {"id": "readme_samples", "label": "Modality-neutral JSONL Sample Schema", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One record shape (id, text, image, optional human_label, metadata) for all modalities so text, vision, and multimodal tasks reuse the same data path and CLI."}, {"id": "readme_teachers", "label": "Protocol-based Teacher Adapters", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapters behind a protocol (BART MNLI, CLIP, OpenRouter VLM, deterministic mocks) let real models be swapped in for offline mocks without touching aggregation or student code."}, {"id": "readme_provenance", "label": "Teacher Signal Provenance and Caching", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each cached signal stores model, source/version, latency, cost, signal type, and a request-derived cache key so paid/external annotation is auditable and re-runs hit the cache instead of the API."}, {"id": "readme_aggregation", "label": "Teacher Signal Aggregation with Abstention", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weighted mean, log-probability mean, or majority voting gated by agreement/confidence/entropy thresholds; abstention is preferred over emitting a low-quality soft label."}, {"id": "readme_students", "label": "Small Local Student Models", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hashed-text and image-stat encoders with an MLP head stay CPU-cheap, keeping the POC runnable without accelerators."}, {"id": "readme_late_fusion", "label": "Explicit Late Fusion for Multimodal Data", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fusion is explicit and late so the text and image encoders stay independent and either modality can be absent at predict time."}, {"id": "readme_lightning_distillation", "label": "Lightning Soft-label Distillation plus Human Cross Entropy", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combining teacher soft labels with human cross entropy lets scarce human labels anchor the student while abundant teacher signals supply the rest of the gradient."}, {"id": "readme_evaluation", "label": "Separated Evaluation Metrics", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human-label accuracy, student/teacher agreement, and teacher abstention rate are reported separately so agreeing with a wrong teacher is not mistaken for accuracy."}, {"id": "readme_self_reported_probability", "label": "self_reported_probability Signal Type", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as its own signal type and deliberately not treated as a calibrated likelihood, because an LLM/VLM stating its own confidence is not a probability."}, {"id": "readme_openrouter_vlm_adapter", "label": "OpenRouter VLM Adapter", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses OpenRouter's documented /api/v1/chat/completions schema and JSON-object response format, requires an env key, and stores its confidence as self-reported."}, {"id": "readme_mock_teachers", "label": "Deterministic Mock Teachers for Demos", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demos use deterministic mock teachers so the whole pipeline is CPU-only and reproducible with no model downloads or API keys; HF teacher configs are left commented for swap-in after installing .[hf]."}, {"id": "readme_cli_pipeline", "label": "generate/annotate/train/evaluate/predict CLI Pipeline", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stage is a separate `python -m specialist_factory` subcommand driven by one config file, so expensive annotation is not re-run on every training experiment."}, {"id": "readme_jev_modernbert_profile", "label": "Jev/ModernBERT Distillation Profile", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Obtains real Jev `noul` class scores, caches the provenance-rich signals, and distills them into answerdotai/ModernBERT-base plus a Laya-inspired marker decision head; needs TYPESAFE_API_KEY (and optional TYPESAFE_BASE_URL) at annotation time."}, {"id": "readme_freeze_encoder", "label": "Frozen Encoder on CPU-only Host", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The demo deliberately freezes the ModernBERT encoder and trains only the decision head on this CPU-only host; freeze_encoder: false is only safe with sufficient accelerator memory."}, {"id": "readme_limits", "label": "POC Limits and Deployment Caveats", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vertical POC, not production MLOps: image student features are intentionally tiny CPU features, API response schemas are provider-specific, and calibration plus held-out human evaluation are required before deployment."}], "edges": [{"source": "readme_specialist_factory", "target": "readme_samples", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_specialist_factory", "target": "readme_teachers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_specialist_factory", "target": "readme_aggregation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_specialist_factory", "target": "readme_students", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_specialist_factory", "target": "readme_evaluation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_specialist_factory", "target": "